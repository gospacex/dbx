replace (
	// dbx resolves these two through its own local replace directives, but
	// replace does not propagate to dependent modules: every consumer has to
	// repeat them or the build cannot resolve configx/logx at all.
	github.com/gospacex/configx => ../../../configx
	github.com/gospacex/dbx => ../../
	github.com/gospacex/logx => ../../../logx
	github.com/gospacex/traceflag => ../../../traceflag
)

// NOTE: no local replace for github.com/gospacex/mqx on purpose. dbx imports
// github.com/gospacex/mqx/kafkax and .../redisx, which exist in upstream
// v0.0.1 but NOT in the sibling ../mqx module (which exposes kafka/ and
// redis/). Repointing mqx at the sibling breaks the import graph.
